# Board Game Arena Configuration
# Get these from browser DevTools -> Network tab -> Copy as cURL
# Extract the cookie values from your BGA session
BGA_PLAYER_ID=your_player_id_here
BGA_USERNAME=your_bga_username
BGA_COOKIES={"PHPSESSID": "xxx", "TournoiEnLigneid": "xxx", "TournoiEnLignetk": "xxx", "TournoiEnLigneidt": "xxx", "TournoiEnLignetkt": "xxx"}

# BoardGameGeek Configuration
# Get these from browser DevTools -> Network tab -> Copy as cURL
# Extract the cookie values from your BGG session
BGG_USERNAME=your_bgg_username
BGG_USER_ID=your_bgg_user_id
BGG_COOKIES={"bggusername": "xxx", "bggpassword": "xxx", "SessionID": "xxx", "_cfuvid": "xxx"}
